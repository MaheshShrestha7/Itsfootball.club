# ===================================================
# itsfootball.club Environment Configuration Template
# ===================================================
# IMPORTANT: Copy this file to .env.local and populate with your production credentials.
# NEVER commit real API keys or secret tokens to version control.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------
# Supabase Configuration
# ---------------------------------------------------
# Obtain from Supabase Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Client Key (Safe for browser):
# Newer format: sb_publishable_xxx (or legacy anon JWT key: eyJxxx)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy alias (optional fallback):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server Secret Key (NEVER expose to browser / client):
# Newer format: sb_secret_xxx (or legacy service_role JWT key: eyJxxx)
SUPABASE_SECRET_KEY=your-secret-key
# Legacy alias (optional fallback):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-client

# ---------------------------------------------------
# Cloudflare R2 Object Storage
# ---------------------------------------------------
# Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=itsfootball-assets
# The public domain mapped to your bucket (or pub-xxx.r2.dev)
R2_PUBLIC_DOMAIN=https://media.itsfootball.club
