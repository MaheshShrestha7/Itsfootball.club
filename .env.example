# ===================================================
# itsfootball.club Environment Configuration Template
# ===================================================
# IMPORTANT: Copy this file to .env.local and populate with your production credentials.
# NEVER commit real API keys or secret tokens to version control.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------
# Supabase Configuration
# ---------------------------------------------------
# Obtain from Supabase Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Client Key (Safe for browser):
# Newer format: sb_publishable_xxx (or legacy anon JWT key: eyJxxx)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy alias (optional fallback):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server Secret Key (NEVER expose to browser / client):
# Newer format: sb_secret_xxx (or legacy service_role JWT key: eyJxxx)
SUPABASE_SECRET_KEY=your-secret-key
# Legacy alias (optional fallback):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-client

# ---------------------------------------------------
# Cloudflare R2 Object Storage
# ---------------------------------------------------
# Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=itsfootball-assets
# The public domain mapped to your bucket (or pub-xxx.r2.dev)
R2_PUBLIC_DOMAIN=https://media.itsfootball.club
# Private bucket (no public domain) for payment and expense receipts.
# If unset, receipts go to the private Supabase Storage bucket `receipts` (needs SUPABASE_SECRET_KEY).
R2_PRIVATE_BUCKET=itsfootball-private

# ---------------------------------------------------
# Stripe (Connect - each club connects its own account)
# ---------------------------------------------------
# Platform secret key: Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=your-stripe-secret-key
# Signing secret of a Connect webhook endpoint ("Events on connected accounts") pointing at
# /api/stripe/webhook, listening to: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, charge.refunded, account.updated
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-secret
# Booking fee on card payments, paid by the payer on top of the club's price and sent to the platform's
# Stripe account. fee = max(price x PERCENT/100 + FLAT, MIN). Amounts in cents (minor units).
# Leave all empty or 0 for no fee. Public on purpose: the payment screen shows the same figure.
# Build-time values: rebuild and redeploy after changing them.
NEXT_PUBLIC_BOOKING_FEE_PERCENT=2
NEXT_PUBLIC_BOOKING_FEE_FLAT_CENTS=0
NEXT_PUBLIC_BOOKING_FEE_MIN_CENTS=30

# ---------------------------------------------------
# Email (Resend) - see docs/email.md
# ---------------------------------------------------
# Resend Dashboard -> API Keys (Sending access is enough)
RESEND_API_KEY=your-resend-api-key
# Sender address on your Resend-verified domain (default notifications@itsfootball.club)
EMAIL_FROM_ADDRESS=notifications@itsfootball.club
# Supabase Dashboard -> Authentication -> Hooks -> Send Email hook secret ("v1,whsec_...")
SEND_EMAIL_HOOK_SECRET=v1,whsec_your-hook-secret
# Any long random string; the daily cron sends it to /api/cron/reminders, and it signs unsubscribe links
CRON_SECRET=your-long-random-string
# Time zone used for match / event times in reminder emails
EMAIL_TIMEZONE=Australia/Sydney

# Club custom domains (Cloudflare for SaaS, see docs/custom-domains.md)
# Token permission: Zone > SSL and Certificates > Edit, on the itsfootball.club zone
CF_HOSTNAMES_TOKEN=your-cloudflare-api-token
CF_ZONE_ID=your-itsfootball-club-zone-id
